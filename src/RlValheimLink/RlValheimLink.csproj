<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>RlValheimLink</AssemblyName>
    <RootNamespace>RlValheimLink</RootNamespace>
    <Description>RL Valheim Link: BepInEx plugin (client + dedicated server) that pushes character, map and item data to Raid Ledger.</Description>
    <Authors>Raid Ledger Plugins</Authors>
    <!-- Game assemblies: VALHEIM_INSTALL=<game dir> uses your own install (publicized at build time);
         otherwise the Digitalroot reference packages (publicized, versioned like the game: 1.0.20 = Valheim 1.0.20). -->
    <ValheimInstall Condition="'$(ValheimInstall)' == ''">$(VALHEIM_INSTALL)</ValheimInstall>
    <ValheimManaged Condition="'$(ValheimInstall)' != ''">$(ValheimInstall)/valheim_Data/Managed</ValheimManaged>
    <ValheimManaged Condition="'$(ValheimInstall)' != '' and !Exists('$(ValheimManaged)')">$(ValheimInstall)/valheim_server_Data/Managed</ValheimManaged>
    <UseLocalGameLibs Condition="'$(ValheimManaged)' != '' and Exists('$(ValheimManaged)/assembly_valheim.dll')">true</UseLocalGameLibs>
    <!-- Must track the game build the operator runs (BepInEx log: "Valheim Version: l-1.0.20", "Detected Unity version: v6000.0.75f1"). -->
    <GameRefsVersion>1.0.20</GameRefsVersion>
    <UnityRefsVersion>6000.0.75</UnityRefsVersion>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="UnityEngine.Modules" Version="$(UnityRefsVersion)" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Framework assembly the Core's HttpClient lives in; Unity's Mono ships System.Net.Http.dll. -->
    <Reference Include="System.Net.Http" />
    <ProjectReference Include="../RlValheimLink.Contract/RlValheimLink.Contract.csproj" />
    <ProjectReference Include="../RlValheimLink.Core/RlValheimLink.Core.csproj" />
  </ItemGroup>

  <!-- Option A: NuGet game refs (CI and anyone without the game). Assembly names inside are the real ones (assembly_valheim etc.). -->
  <ItemGroup Condition="'$(UseLocalGameLibs)' != 'true'">
    <PackageReference Include="Digitalroot.Valheim.Common.References" Version="$(GameRefsVersion)" />
  </ItemGroup>

  <!-- Option B: your own install, publicized on the fly (docs/reference-assemblies.md). -->
  <ItemGroup Condition="'$(UseLocalGameLibs)' == 'true'">
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
    <Reference Include="assembly_valheim" Publicize="true"><HintPath>$(ValheimManaged)/assembly_valheim.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_guiutils" Publicize="true"><HintPath>$(ValheimManaged)/assembly_guiutils.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_utils" Publicize="true"><HintPath>$(ValheimManaged)/assembly_utils.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="ReportGameLibs" BeforeTargets="CoreCompile">
    <Message Importance="high" Condition="'$(UseLocalGameLibs)' == 'true'" Text="RlValheimLink: game assemblies from local install at $(ValheimManaged)" />
    <Message Importance="high" Condition="'$(UseLocalGameLibs)' != 'true'" Text="RlValheimLink: game assemblies from NuGet Digitalroot.Valheim.Common.References $(GameRefsVersion) + UnityEngine.Modules $(UnityRefsVersion)" />
  </Target>
</Project>
