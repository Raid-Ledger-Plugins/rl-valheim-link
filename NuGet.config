<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- BepInEx.Core and UnityEngine.Modules live only here. -->
    <add key="bepinex" value="https://nuget.bepinex.dev/v3/index.json" />
  </packageSources>
  <!-- Source mapping: a hiccup on the BepInEx feed must not break restoring the contract library or the tests. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="bepinex">
      <package pattern="BepInEx.*" />
      <package pattern="UnityEngine.Modules" />
    </packageSource>
  </packageSourceMapping>
</configuration>
